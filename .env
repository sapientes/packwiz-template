eval "$(tombl -e VERSIONS=versions -e DISPLAY_NAME=name -e VERSION=version pack.toml)"

if [ "${VERSIONS[fabric]+true}" ]; then
    LOADER="fabric"
    LOADER_VERSION=${VERSIONS[fabric]}
elif [ "${VERSIONS[forge]+true}" ]; then
    LOADER="forge"
    LOADER_VERSION=${VERSIONS[forge]}
else
    echo "Loader couldn't be determined"
    exit 1
fi

MINECRAFT_VERSION="${VERSIONS[minecraft]}"

# Set these manually
REPOSITORY="sapientes/packwiz-template"
BRANCH='v0'
NAME='template'
